# API 순위 24h (Cloudtype 환경변수에 설정 — git에 커밋 금지)

# ★ 권장: 네이버 개발자센터 쇼핑 검색 API (최대 1000위, 24h 안정)
# https://developers.naver.com/apps/#/register → Application > 쇼핑 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 보조: SerpAPI (쇼핑 캐러셀 ~8위만 반영)
SERPAPI_KEY=

GOOGLE_API_KEY=
GOOGLE_CSE_ID=
RANK_USE_API=1

# GCS 데이터 영속화 (Cloudtype 재시작 후에도 rank_history 유지)
GCS_BUCKET=
GCS_PREFIX=traffic-data

# 외부 cron 호출 보안 (선택)
CRON_SECRET=

# 로컬 .env 대신 다른 경로 지정 시
# TRAFFIC_ENV_FILE=D:\path\to\.env
